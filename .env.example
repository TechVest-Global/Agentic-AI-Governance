APP_NAME="Agentic AI Governance Engine"
APP_ENV=local
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Local development uses a locally installed PostgreSQL service.
# Keep these names aligned with your local database/user, or update DATABASE_URL.
POSTGRES_DB=agentic_ai_governance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agentic_ai_governance

# Azure-ready settings. Local development reads secrets from environment variables.
SECRETS_PROVIDER=env
AZURE_KEY_VAULT_URL=

# Company direction: Azure AI Foundry for model integrations.
AI_MODEL_PROVIDER=azure_foundry
TARGET_MODEL_PROVIDER=azure_foundry
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_PROJECT_NAME=
AZURE_AI_FOUNDRY_DEPLOYMENT_NAME=

# Audited target systems. TARGET_* is the global default; the per-kind pairs
# below let audits of different registered systems route to their own
# endpoints simultaneously (endpoint normally comes from the system's
# registered target_endpoint_ref; the key must match that system's API).
TARGET_ENDPOINT=
TARGET_API_KEY=
TARGET_SYSTEM_KIND=techvest
HR_GATEWAY_ENDPOINT=
HR_GATEWAY_API_KEY=
TECHVEST_ENDPOINT=
TECHVEST_API_KEY=
