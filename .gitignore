__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
.vite/

venv/
.venv/
.venv-pyrit/
.venv-ragas/
env/

.env
.env.*
!.env.example

*.sqlite
*.sqlite3
*.db

node_modules/
.next/
dist/
build/
*.log
*.err

# Keep local planning/company docs out of GitHub.
*.doc
*.docx
*.docm
*.ppt
*.pptx
*.pptm
*.xls
*.xlsx
*.xlsm
~$*

# Local/shareable progress reports that are not source documentation.
docs/person1-backend-progress-*.html

# Local team scheduling and assignment tracker; product/engineering truth lives
# in the specification and companion technical documents.
docs/PROJECT_PLAN.md

# OS / IDE artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.code-workspace

# Alembic auto-generated migration scripts are source-controlled, but the
# compiled __pycache__ inside migrations/ is not (already covered by __pycache__/).

# Pytest and coverage artefacts
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# MyPy / Ruff / type-checker caches
.mypy_cache/
.ruff_cache/

# Jupyter notebooks if any end up in the repo accidentally
*.ipynb_checkpoints/

# Temporary script outputs and scratchpad files
*.tmp
*.bak

# Local test corpora / context documents used to exercise a real target system
# (e.g. a knowledge base seeded into an audited RAG app). These are inputs for
# local runs, not source — and are usually customer content that should never
# reach the repo. The *.docx/*.xlsx rules above already cover the office
# formats; this covers the plain-text ones.
*knowledge_base*.txt

# Scratch JSON emitted by the local analysis/report scripts in backend/scripts
# (probe transcripts, metric report rows, agent timing captures). Regenerated on
# every run, so committing them only creates churn and stale evidence.
backend/scripts/_*.json

# Draft pull-request descriptions. These belong in the PR itself, not in the
# repository, where they immediately go stale.
pr_body.md

.deepeval/

# Database backups (backend/scripts/backup_database.py) — real dumps of
# production/dev data, never belong in source control.
/backups/
